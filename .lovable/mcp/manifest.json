{
  "version": 1,
  "sdk_version": "0.26.3",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://apxzuslwhjujgrcsfzqw.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "remix-of-startup-companion",
      "version": "0.1.0",
      "title": "Remix of Startup Companion"
    },
    "tools": [
      {
        "name": "list_workspaces",
        "title": "List workspaces",
        "description": "List the startup workspaces the signed-in user can access, with stage, health score and program.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Maximum workspaces to return."
            },
            "search": {
              "type": "string",
              "description": "Optional startup name filter."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_workspace_overview",
        "title": "Get workspace overview",
        "description": "Get one workspace with its startup, program, milestones and open action items. Use list_workspaces to find the id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "workspace_id": {
              "type": "string",
              "format": "uuid",
              "description": "Workspace id."
            }
          },
          "required": [
            "workspace_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_action_items",
        "title": "List action items",
        "description": "List action items across accessible workspaces. Optionally filter by workspace, status, or only overdue items.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "workspace_id": {
              "type": "string",
              "format": "uuid",
              "description": "Restrict to a single workspace."
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "awaiting_validation",
                "completed",
                "cancelled"
              ],
              "description": "Filter by action status."
            },
            "only_overdue": {
              "type": "boolean",
              "default": false,
              "description": "Only items past their due date and not completed."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_action_item",
        "title": "Create action item",
        "description": "Create an action item inside a milestone of a workspace. Every action must belong to a milestone — use get_workspace_overview to pick one.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "workspace_id": {
              "type": "string",
              "format": "uuid",
              "description": "Workspace the action belongs to."
            },
            "milestone_id": {
              "type": "string",
              "format": "uuid",
              "description": "Milestone the action belongs to."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Short action title."
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "due_date": {
              "type": "string",
              "description": "Due date as YYYY-MM-DD."
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "default": "medium"
            }
          },
          "required": [
            "workspace_id",
            "milestone_id",
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_upcoming_sessions",
        "title": "List upcoming sessions",
        "description": "List upcoming sessions (meetings) in the workspaces the signed-in user can access.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "workspace_id": {
              "type": "string",
              "format": "uuid",
              "description": "Restrict to a single workspace."
            },
            "days_ahead": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30,
              "description": "How far ahead to look, in days."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_crm_leads",
        "title": "List CRM leads",
        "description": "List CRM pipeline leads (funnel items) the signed-in user can access, newest first. Optionally filter by stage or organisation name.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "stage": {
              "type": "string",
              "description": "Funnel stage key to filter by."
            },
            "search": {
              "type": "string",
              "description": "Organisation name filter."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
